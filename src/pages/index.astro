---
import destinations from '../data/destinations.json';
import type { DestinationClimate } from '../data/climate';
import DestinationComparison from '../components/DestinationComparison';
import DestinationFilters from '../components/DestinationFilters';

const climateDestinations = destinations as DestinationClimate[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Compare historical monthly climate averages for curated holiday destinations."
    />
    <title>Where Is It Sunny?</title>
  </head>
  <body>
    <main>
      <h1>Where is it sunny?</h1>
      <p>
        Compare historical climate averages for representative points. These are not forecasts for a
        particular trip.
      </p>
      <DestinationFilters client:load destinations={climateDestinations} />
      <DestinationComparison client:load destinations={climateDestinations} />

      <section aria-labelledby="data-source">
        <h2 id="data-source">Data source</h2>
        <p>
          Values are from <a href={climateDestinations[0].source.documentationUrl}>NASA POWER</a> for
          {' '}{climateDestinations[0].climate.period.description}. Temperature is mean air temperature
          at 2 metres. Rainfall is corrected precipitation, converted from daily averages to an estimated
          calendar-month total. Solar radiation is all-sky surface shortwave downward irradiance—not
          hours of sunshine.
        </p>
        <p>
          The API response used {climateDestinations[0].source.dataSources.join(', ')} and reports
          {' '}a missing-value marker of {climateDestinations[0].source.fillValue}; missing values are
          rejected during generation. Each destination represents a returned grid point, not all local
          microclimates.
        </p>
        <p><a href="/methodology/">Read the methodology and data attribution.</a></p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    color: #1b2630;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    margin: 0;
  }

  main {
    margin: 0 auto;
    max-width: 70rem;
    padding: 2rem 1rem 4rem;
  }

</style>
